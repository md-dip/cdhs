# Copy this file to .env and fill in real values from your Supabase project
# (Project Settings -> API in the Supabase dashboard). Never commit .env.

# Client-safe — Vite inlines VITE_-prefixed vars into the browser bundle at build time.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only — do NOT prefix with VITE_, or it would ship to every visitor's browser.
# Only needed for admin-user management (inviting new admins). Keep this secret.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
